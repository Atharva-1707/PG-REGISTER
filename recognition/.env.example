API_URL=http://localhost:4000
SERVICE_TOKEN=change-me       # must match the backend's

# --- cameras -----------------------------------------------------------
# TWO cameras (recommended): one watching people come in, one watching people
# go out. Run `python3 list_cameras.py` with both plugged in to see the numbers.
#
#   Cam 1  faces the PG door from inside  -> whoever it recognises is coming IN
#   Cam 2  faces away from the door, out  -> whoever it recognises is going OUT
#
# If you mounted or plugged them the other way round, don't edit this file:
# press "Swap cameras" on the At the Door page. It takes effect in seconds.
#
# Laptop with a built-in camera + an external webcam: usually 0 and 1.
# An IP camera works too: rtsp://user:pass@192.168.1.50:554/stream1
CAMERA_1_SOURCE=0
CAMERA_2_SOURCE=1
# The service starts with just one camera if the other isn't plugged in yet,
# and picks the second one up by itself within CAMERA_RETRY_SECONDS.
CAMERA_RETRY_SECONDS=10
# Two cameras at 1080p can saturate a laptop's USB. 1280x720 is plenty for a
# face at a doorway. Leave at 0 to use each camera's own default.
CAMERA_WIDTH=0
CAMERA_HEIGHT=0
# If both cameras see the same person within this many seconds, only the first
# counts (an "in" then an "out" seconds apart is one person, not a round trip).
CROSS_CAMERA_SECONDS=8
# How often to check the Swap button. Only used until the register answers.
CAMERA_ROLE_POLL_SECONDS=3
CAMERAS_SWAPPED=0

# ONE camera instead? Delete the CAMERA_1/2 lines above and use this: direction
# is then guessed from whether the face is getting bigger (see APPROACH_MEANS).
# CAMERA_SOURCE=0
MODEL_PACK=buffalo_l          # used by BOTH the camera and enrolling. Changing it means re-adding every guest
DETECT_WIDTH=640              # frames downscaled to this before detection
DET_SIZE=640

MATCH_THRESHOLD=0.42          # tune on your own faces, not on a blog post's numbers
MATCH_MARGIN=0.06             # best must beat runner-up by this, else "unknown"
COOLDOWN_SECONDS=120
MIN_FACE_PX=60
MIN_TRACK_FRAMES=3

APPROACH_MEANS=in             # ONE-camera setup only: face growing larger = walking in. Two cameras ignore this.
LOG_UNKNOWNS=1

# --- CPU ---------------------------------------------------------------
# The motion gate is what makes this comfortable on a fanless mini PC. It
# compares each frame to the last one on a thumbnail, and only wakes the face
# detector when something changed. An empty corridor costs almost nothing.
# Turn it off only to prove what it was saving you.
MOTION_GATE=1
MOTION_PIXEL_DELTA=8          # a pixel must change by this much to count
MOTION_MIN_CHANGED=0.0035     # ...and this share of pixels must change
MOTION_HOLD_FRAMES=18         # keep detecting this long after movement stops
MOTION_FORCE_EVERY=24         # detect anyway this often, so a still person can't hide

MAX_FPS=12                    # the camera may offer 30; a walk-past doesn't need it

# Raise MOTION_MIN_CHANGED if a swaying curtain or a passing headlight keeps
# waking the detector. Lower it if someone can cross the frame unnoticed —
# then check the log line, which prints the share of frames skipped.

# --- live view ---------------------------------------------------------
# Frames for the dashboard's door screen. Only sent while somebody has that
# page open; nobody watching costs nothing at all.
LIVE_VIEW=1
LIVE_VIEW_FPS=4
LIVE_VIEW_WIDTH=480
LIVE_VIEW_QUALITY=60

# How often to notice a guest added from the dashboard. No restart needed.
GALLERY_POLL_SECONDS=5

LIVENESS_ENABLED=0            # off by default — see README. 1 to reject flat/glared crops as unknown
LIVENESS_BLUR_FLOOR=60
LIVENESS_CHROMA_LOW=5
LIVENESS_CHROMA_HIGH=32
LIVENESS_GLARE_CEILING=0.12
